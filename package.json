{
  "name": "meu-vendedor",
  "version": "0.1.0",
  "private": true,
  "description": "Meu Vendedor — Viral Commerce AI: plataforma web de marketing de afiliados com IA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.mjs",
    "video:demo": "node scripts/generate-video-demo.mjs",
    "build:pages": "MEU_VENDEDOR_STATIC_EXPORT=1 next build --webpack",
    "deploy:cloudflare": "npm run build:pages && wrangler deploy",
    "typecheck:edge": "tsc --noEmit -p tsconfig.edge.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
