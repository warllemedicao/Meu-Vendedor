{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-vendedor",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "keep_vars": true,
  "vars": { "MV_FLOW_EXECUTOR_URL": "https://warllemedicao--meu-vendedor-flow-gateway.us-east.modal.run/control" },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "main": "worker/runtime.ts",
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "GOOGLE_FLOW_SESSIONS", "class_name": "GoogleFlowSession" }] },
  "migrations": [{ "tag": "google-flow-v1", "new_sqlite_classes": ["GoogleFlowSession"] }],
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "* * * * *"
    ]
  }
}
