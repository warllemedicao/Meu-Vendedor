{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-vendedor",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/index.ts",
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}
